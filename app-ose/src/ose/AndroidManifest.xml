<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application>

        <!--
          Kompakt runs the whole OAuth flow in an embedded WebView (KompaktOAuthWebViewActivity),
          which captures the redirect in-process. The Custom Tabs / AppAuth custom-scheme redirect is
          never dispatched to the OS, so the exported RedirectUriReceiverActivity is not needed and is
          intentionally omitted (removing it also drops the exported custom-scheme attack surface).
          core/src/main/AndroidManifest.xml already strips AppAuth's own injected copy via tools:node="remove".
        -->

    </application>

</manifest>