<resources xmlns:tools="http://schemas.android.com/tools">

    <!--
      Kompakt: plain white, blank splash screen (no app icon).
      Overrides the system splash (Android 12+) background/icon and the window background used as the
      cold-start splash on older versions.
    -->
    <style name="Theme.Kompakt.Splash" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@android:color/white</item>
        <item name="android:windowSplashScreenBackground" tools:targetApi="31">@android:color/white</item>
        <item name="android:windowSplashScreenAnimatedIcon" tools:targetApi="31">@android:color/transparent</item>
    </style>

</resources>
